{
  "schema": "openforge.plugin/v2",
  "id": "dev.openforge.browser",
  "version": "0.2.0",
  "runtime": "process",
  "entrypoint": "packages/browser-worker/dist/index.js",
  "api": ">=0.2 <1.0",
  "capabilities": {
    "filesystem": [],
    "network": ["http://*", "https://*"],
    "secrets": [],
    "database": [],
    "shell": [],
    "mcp": [],
    "acp": [],
    "cloud": [],
    "deployment": [],
    "browser": ["navigate", "click", "fill", "text", "html", "screenshot", "console"],
    "git": []
  },
  "contributes": {
    "tools": [
      "browser.navigate",
      "browser.click",
      "browser.fill",
      "browser.text",
      "browser.html",
      "browser.screenshot",
      "browser.console"
    ]
  }
}
