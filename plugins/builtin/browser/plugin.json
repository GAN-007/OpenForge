{
  "schema": "openforge.plugin/v1",
  "id": "dev.openforge.browser",
  "version": "0.1.0",
  "runtime": "process",
  "entrypoint": "packages/browser-worker/dist/index.js",
  "api": ">=0.1 <1.0",
  "capabilities": {
    "filesystem": [],
    "network": ["http://*", "https://*"],
    "secrets": [],
    "database": [],
    "shell": []
  },
  "contributes": {
    "tools": [
      "browser.navigate",
      "browser.click",
      "browser.fill",
      "browser.text",
      "browser.html",
      "browser.screenshot",
      "browser.console"
    ]
  }
}
