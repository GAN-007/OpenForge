{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openforge.dev/schemas/model-provider.schema.json",
  "title": "OpenForge model provider",
  "description": "Canonical configuration contract for one OpenForge model provider and its models.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind", "models"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["openai-compatible", "anthropic", "gemini", "bedrock-aws-cli"]
    },
    "base_url": {
      "type": "string"
    },
    "api_key_env": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "context_tokens",
          "input_usd_per_million",
          "output_usd_per_million"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "context_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "tools": {
            "type": "boolean"
          },
          "vision": {
            "type": "boolean"
          },
          "structured_output": {
            "type": "boolean"
          },
          "input_usd_per_million": {
            "type": "number",
            "minimum": 0
          },
          "output_usd_per_million": {
            "type": "number",
            "minimum": 0
          },
          "latency_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "quality_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "privacy_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "max_data_classification": {
            "type": "string",
            "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
          }
        }
      }
    }
  }
}
