{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openforge.dev/schemas/plugin/plugin.schema.json",
  "title": "OpenForge Plugin Manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "runtime",
    "entrypoint",
    "api",
    "capabilities"
  ],
  "properties": {
    "schema": {"const": "openforge.plugin/v1"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$"
    },
    "version": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["wasm", "process", "mcp"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "api": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "properties": {
        "filesystem": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "secrets": {"type": "array", "items": {"type": "string"}},
        "database": {"type": "array", "items": {"type": "string"}},
        "shell": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
