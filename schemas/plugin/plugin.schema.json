{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openforge.dev/schemas/plugin/plugin.schema.json",
  "title": "OpenForge Plugin Manifest v2",
  "type": "object",
  "required": ["schema", "id", "version", "runtime", "entrypoint", "api", "capabilities"],
  "properties": {
    "schema": {"const": "openforge.plugin/v2"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$"},
    "version": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["wasm", "process", "mcp"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "api": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "properties": {
        "filesystem": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "network": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "secrets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "database": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "shell": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mcp": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acp": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cloud": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deployment": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "browser": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "git": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }
  },
  "additionalProperties": false
}
