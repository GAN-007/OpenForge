{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@openforge/sdk": [
        "packages/sdk-typescript/src/index.ts"
      ],
      "@openforge/ui": [
        "packages/ui-components/src/index.tsx"
      ]
    }
  }
}
